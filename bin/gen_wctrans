else {
    # print larger exclusion ranges. iswalpha is useless with glibc
    print FH "    if (";
}

# generate the excl ranges here, because it is more stable
my %alpha;
$alpha{$_}++ for keys %lower;
$alpha{$_}++ for keys %upper;
my @sorted = sort { $a <=> $b } keys %alpha;
my $first  = $sorted[0];
my $last   = $sorted[-1];
@excl = ( [ 0, $first - 1 ] );

for ( $first + 1 .. $last - 1 ) {
    if ( !exists $alpha{$_} ) {
        add_excl( \@excl, $_ );
    }
}

